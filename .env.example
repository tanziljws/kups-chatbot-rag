# Copy to .env.local. Keep secrets server-side and do not commit .env.local.

# Optional local ONNX encoder for FAQ/document retrieval only; it does not generate replies.
# First ingestion downloads model files to .cache/huggingface.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
HF_ALLOW_REMOTE=true

# Server-to-server connection to KUPS-Web's public catalog endpoint.
# This key must match CHATBOT_API_KEY in the KUPS-Web server environment.
KUPS_WEB_CATALOG_URL=http://127.0.0.1:3000/api/chatbot/catalog
KUPS_WEB_API_KEY=

# Retrieval defaults; evaluate Indonesian KUPS queries and tune before launch.
RAG_TOP_K=2
RAG_MIN_SCORE=0.45
CHAT_MAX_CHARS=1000

# Protect the human consultant inbox. In development, local-kups-dev is used if unset.
# Set a long random value before exposing the service in production.
LIVE_CHAT_OPERATOR_TOKEN=
LIVE_CHAT_OPERATOR_NAME=Konsultan KUPS
